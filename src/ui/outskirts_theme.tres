[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="Body"]
font_names = PackedStringArray("Segoe UI", "Noto Sans", "DejaVu Sans")

[sub_resource type="SystemFont" id="Heading"]
font_names = PackedStringArray("Georgia", "Noto Serif", "DejaVu Serif")

[sub_resource type="StyleBoxFlat" id="Normal"]
content_margin_left = 16.0
content_margin_top = 9.0
content_margin_right = 16.0
content_margin_bottom = 10.0
bg_color = Color(0.086, 0.101, 0.12, 0.96)
border_width_left = 2
border_width_bottom = 1
border_color = Color(0.55, 0.43, 0.28, 1)

[sub_resource type="StyleBoxFlat" id="Hover"]
content_margin_left = 16.0
content_margin_top = 9.0
content_margin_right = 16.0
content_margin_bottom = 10.0
bg_color = Color(0.18, 0.158, 0.123, 1)
border_width_left = 2
border_width_bottom = 1
border_color = Color(0.88, 0.71, 0.44, 1)

[sub_resource type="StyleBoxFlat" id="Focus"]
draw_center = false
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.86, 0.72, 0.49, 0.9)

[sub_resource type="StyleBoxFlat" id="Panel"]
content_margin_left = 20.0
content_margin_top = 14.0
content_margin_right = 20.0
content_margin_bottom = 17.0
bg_color = Color(0.045, 0.055, 0.071, 0.93)
border_width_top = 1
border_color = Color(0.59, 0.47, 0.30, 0.8)

[resource]
default_font = SubResource("Body")
default_font_size = 17
Label/colors/font_color = Color(0.91, 0.90, 0.85, 1)
Button/colors/font_color = Color(0.95, 0.90, 0.79, 1)
Button/colors/font_hover_color = Color(1, 0.97, 0.91, 1)
Button/styles/normal = SubResource("Normal")
Button/styles/hover = SubResource("Hover")
Button/styles/pressed = SubResource("Hover")
Button/styles/focus = SubResource("Focus")
PanelContainer/styles/panel = SubResource("Panel")
Display/base_type = &"Label"
Display/fonts/font = SubResource("Heading")
Display/colors/font_color = Color(0.97, 0.89, 0.74, 1)
Accent/base_type = &"Label"
Accent/colors/font_color = Color(0.86, 0.69, 0.44, 1)
Muted/base_type = &"Label"
Muted/colors/font_color = Color(0.64, 0.69, 0.73, 1)
