[sub_resource type="AnimationNodeBlendSpace1D" id="Locomotion"]
blend_point_0/node = SubResource("Idle")
blend_point_0/pos = 0.0
blend_point_1/node = SubResource("Walk")
blend_point_1/pos = 0.36
blend_point_2/node = SubResource("Run")
blend_point_2/pos = 1.0
min_space = 0.0

[sub_resource type="AnimationNodeStateMachineTransition" id="Start"]
advance_mode = 2

[sub_resource type="AnimationNodeStateMachineTransition" id="Action"]
xfade_time = 0.15

